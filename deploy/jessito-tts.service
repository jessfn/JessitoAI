[Unit]
Description=Voz de Jessito (Kokoro, voz Santa)
After=network.target

[Service]
User=www-data
Environment=HF_HOME=/opt/jessito-voces/hf
Environment=HF_HUB_OFFLINE=1
Environment=TTS_CACHE=/var/cache/jessito-tts
Environment=TTS_THREADS=3
Environment=PYTHONIOENCODING=utf-8
WorkingDirectory=/var/www/jessito/server
ExecStart=/opt/jessito-voces/venv/bin/python tts_service.py
Restart=always
RestartSec=5
Nice=5
MemoryMax=6G

[Install]
WantedBy=multi-user.target
